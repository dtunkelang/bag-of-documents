<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily jobs-demo refresh. launchd is preferred over cron on a laptop: if the
  machine is asleep/off at the scheduled time, launchd coalesces the missed run
  and fires it on the next wake (cron silently skips it).

  Install:
    cp jobs_search_demo/launchd/com.dtunkelang.jobs-refresh.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.dtunkelang.jobs-refresh.plist
  Run once now (test):   launchctl start com.dtunkelang.jobs-refresh
  Tail the log:          tail -f ~/Library/Logs/jobs-refresh.log
  Uninstall:             launchctl unload -w ~/Library/LaunchAgents/com.dtunkelang.jobs-refresh.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dtunkelang.jobs-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dtunkelang/bagofdocs/jobs_search_demo/daily_jobs_refresh.sh</string>
  </array>

  <!-- Every day at 03:00 local. Missed runs (laptop asleep) fire on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/dtunkelang/bagofdocs</string>

  <key>StandardOutPath</key>
  <string>/Users/dtunkelang/Library/Logs/jobs-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dtunkelang/Library/Logs/jobs-refresh.log</string>

  <!-- Don't run at load/login; only on the schedule. -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
